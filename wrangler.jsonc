{
  "name": "trekbattles-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  // No id on purpose: wrangler creates the namespace on first deploy and fills it in.
  "routes": [
    { "pattern": "trekbattles.com", "custom_domain": true },
    { "pattern": "www.trekbattles.com", "custom_domain": true }
  ],
  "kv_namespaces": [{ "binding": "VISITS" }]
}
